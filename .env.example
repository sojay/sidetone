# Copy to .env and fill in. Nothing here is read automatically — see the note
# below — and .env is gitignored.
#
#   set -a; source .env; set +a
#   ./sidetone

# Listen port for the webhook server and band scope.
PORT=8080

# The internal integration's client secret. Verifies alerts arriving FROM
# Sentry. Must be the integration's real secret — a placeholder makes every
# real alert fail with 401 instead of honestly reporting itself unconfigured.
SENTRY_CLIENT_SECRET=

# The project's DSN. Used only by -fire, to send errors TO Sentry. Write-only:
# it grants no read access, so it cannot receive alerts.
SENTRY_DSN=

# Output level, 0.0 to 1.0.
VOLUME=0.8
